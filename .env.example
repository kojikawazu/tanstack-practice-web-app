# --- アプリ ---
NODE_ENV=development
PORT=3000

# PostgreSQL 接続文字列（api / packages/db が参照）
DATABASE_URL=postgres://app:app@localhost:5432/tasks

# セッション署名用シークレット（32文字以上推奨）
SESSION_SECRET=change-me-to-a-long-random-string-32chars
# セッション有効期限（秒。デフォルト 7 日）
SESSION_TTL=604800

# 許可するフロントのオリジン（CORS）
CORS_ORIGIN=http://localhost:5173

# --- フロント（apps/web、VITE_ プレフィックスのみ露出） ---
VITE_API_BASE_URL=http://localhost:3000

# --- docker-compose（PostgreSQL コンテナ） ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=tasks
